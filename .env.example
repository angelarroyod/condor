# Copy to .env and adjust. No secrets belong in the repo.

# --- Postgres (compose reads POSTGRES_*; the app reads DATABASE_URL) ---
POSTGRES_USER=condor
POSTGRES_PASSWORD=condor
POSTGRES_DB=condor
DATABASE_URL=postgresql+asyncpg://condor:condor@db:5432/condor

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Market data ---
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# --- API ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=true
